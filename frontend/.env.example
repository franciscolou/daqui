# Login com Google (ver components/GoogleSignInButton.tsx/.web.tsx).
# Client ID tipo "Aplicativo da Web" do Google Cloud Console — mesmo valor
# usado pelo backend (GOOGLE_WEB_CLIENT_ID) para validar o id_token, inclusive
# quando ele vem do fluxo nativo (iOS/Android configuram GoogleSignin com este
# valor como webClientId de propósito, pra sair só uma audience).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Só necessário pra rebuildar o app nativo (iOS): Client ID tipo "iOS" do
# mesmo projeto no Google Cloud Console. O login com Google na web funciona
# normalmente sem esta variável.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
