# Local: sobe com `docker compose up -d db` na raiz do repo (ver docker-compose.yml).
# Produção: URL do Postgres gerenciado (RDS/Supabase/Neon/etc).
DATABASE_URL=postgresql+psycopg://daqui:daqui@localhost:5432/daqui
SECRET_KEY=troque-por-uma-chave-secreta-forte-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT=development

# Usado para montar o link de redefinição de senha enviado por e-mail.
FRONTEND_URL=http://localhost:8081

# URL do painel de moderação (moderator/index.html) — usada só no link de
# convite de conta de staff (a conta ainda não existe pra logar no app).
MODERATOR_URL=http://localhost:8090

# Opcional — sem chave, o autocomplete de endereço roda só no Nominatim
# (grátis), sem interpolação de número exato. Cadastro: developer.here.com.
HERE_API_KEY=

# Opcional — sem chave, /auth/google responde 501 (login com Google
# desligado). Client ID tipo "Aplicativo da Web" do Google Cloud Console;
# usado também pelo app nativo (ver frontend, EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID).
GOOGLE_WEB_CLIENT_ID=

# Opcional — sem R2_BUCKET_NAME, uploads (fotos, vídeos, criativos de
# anúncio) caem pro disco local em UPLOAD_DIR, servido em /uploads. Só serve
# pra dev local; em produção configure um bucket R2 (dashboard.cloudflare.com
# → R2), com "Public access" habilitado (r2.dev ou domínio custom) pra
# R2_PUBLIC_URL funcionar.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Anúncios — Asaas Checkout: sandbox.asaas.com (chave começa com
# "$aact_hmlg_") ou asaas.com em produção (ENVIRONMENT acima decide qual host
# a API usa, ver core/payments.py). ASAAS_WEBHOOK_TOKEN é um valor que você
# mesmo escolhe e cadastra em Configurações -> Integrações -> Webhooks no
# dashboard do Asaas, apontando pra {sua URL}/api/v1/ads/webhook/asaas.
ADS_CHECKOUT_SUCCESS_URL=http://localhost:8081/advertise/checkout/success
ADS_CHECKOUT_CANCEL_URL=http://localhost:8081/advertise/checkout
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

ADS_ADMIN_EMAIL=ads@daqui.com
ADS_ADMIN_PASSWORD=senha123

# URL do painel de anúncios (ads-admin/index.html) — usada só no link de
# convite de conta de staff e de redefinição de senha de AdAdmin.
ADS_ADMIN_URL=http://localhost:8091
