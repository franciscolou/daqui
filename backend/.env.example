DATABASE_URL=sqlite:///./daqui.db
SECRET_KEY=troque-por-uma-chave-secreta-forte-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT=development

# Usado para montar o link de redefinição de senha enviado por e-mail.
FRONTEND_URL=http://localhost:8081

# URL do painel de moderação (moderator/index.html) — usada só no link de
# convite de conta de staff (a conta ainda não existe pra logar no app).
MODERATOR_URL=http://localhost:8090

# Opcional — sem chave, o autocomplete de endereço roda só no Nominatim
# (grátis), sem interpolação de número exato. Cadastro: developer.here.com.
HERE_API_KEY=

# Opcional — sem chave, /auth/google responde 501 (login com Google
# desligado). Client ID tipo "Aplicativo da Web" do Google Cloud Console;
# usado também pelo app nativo (ver frontend, EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID).
GOOGLE_WEB_CLIENT_ID=
